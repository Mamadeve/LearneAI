# ==== Telegram ====
BOT_TOKEN=your-telegram-bot-token
ADMIN_IDS=12345678,87654321

# ==== Hugging Face Spaces / Webhook ====
# The public URL of your HF Space (e.g., https://username-spacename.hf.space)
APP_URL=
# Enable self-pinging background task to prevent the Space from sleeping? (true/false)
ENABLE_ANTI_SLEEP=true

# ==== Database (Supabase PostgreSQL) ====
# Supabase connection URI (must include your password)
DATABASE_URL=postgresql://postgres.xxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# ==== LLM API Keys ====
GROQ_API_KEY=your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key
OPENROUTER_API_KEY=your_openrouter_api_key

# ==== STT/TTS overrides (Optional) ====
HF_API_TOKEN=your_hf_token_for_stt
