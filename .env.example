# ==========================================================
#  LearneAI Bot — Environment Configuration
#  Copy this file to `.env` and fill in the values.
#  NOTE: Everything in the [DYNAMIC API] section can also be
#  changed live from the in-app Admin Panel (no restart needed).
# ==========================================================

# ---------- Bot Core ----------
BOT_TOKEN=123456789:AAF...your_telegram_bot_token_here
ADMIN_IDS=123456789,987654321
# Comma-separated Telegram user IDs with admin panel access.

# ---------- Database ----------
# SQLite by default. For PostgreSQL later, just point DATABASE_URL at:
# postgresql+asyncpg://user:password@host:5432/learneai
DATABASE_URL=sqlite+aiosqlite:///./learneai.db

# ---------- Default LLM Provider ----------
# Which provider to use out of the box: "groq" | "gemini"
LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-8b-instant
# Groq free tier: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_key_here
# Gemini free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here

# ---------- STT (Speech-to-Text) ----------
# "groq" (Whisper via Groq, recommended) | "hf" (Hugging Face Inference API)
STT_PROVIDER=groq
STT_MODEL=whisper-large-v3
HF_API_TOKEN=hf_your_huggingface_token_here

# ---------- TTS (Text-to-Speech) ----------
# edge-tts is fully free & keyless. Voice is auto-picked per target language,
# but you can force a default voice name (e.g. "en-US-JennyNeural").
TTS_PROVIDER=edge
TTS_DEFAULT_VOICE=

# ---------- Translation ----------
# "google" (free via deep-translator) | "libre" (self-host / public instance)
TRANSLATION_PROVIDER=google
LIBRETRANSLATE_URL=https://libretranslate.com/translate
LIBRETRANSLATE_API_KEY=

# ==========================================================
#  DYNAMIC API OVERRIDES
#  These are the *initial* values of the runtime API config.
#  Admins can change any of them live via the Admin Panel —
#  changes are cached in DB/global state and applied instantly.
# ==========================================================
# Example live override commands supported by the admin panel:
#   /api provider gemini
#   /api model gemini-1.5-flash
#   /api key groq gsk_new_key_here
